# ===== 应用 =====
APP_ENV=dev
# JWT 密钥，生产环境务必改成随机长字符串（不要提交真实密钥）
JWT_SECRET=change-me-to-a-random-32-chars-secret
TOKEN_EXPIRE_MINUTES=720

# ===== 数据库 =====
# 默认 SQLite，开箱即用；换库示例：
#   postgresql+psycopg://aigc:aigc@127.0.0.1:5432/aigc
#   mysql+pymysql://aigc:aigc@127.0.0.1:3306/aigc
DATABASE_URL=
DB_ECHO=0

# ===== 存储 =====
# 素材、缩略图、导出文件落盘目录（相对 backend/）
STORAGE_DIR=storage

# ===== AIGC 生成 =====
# mock（离线占位，默认）/ comfyui / openai
GENERATION_PROVIDER=mock
# 生成线程数
GENERATION_WORKERS=2
# 单个任务截止秒数，超时标记为 timeout
GENERATION_DEADLINE_SECONDS=60
# 1 = 同步生成（测试用），0 = 后台线程池
GENERATION_INLINE=0

# ComfyUI 本地服务（可选）
COMFYUI_BASE_URL=
COMFYUI_WORKFLOW_PATH=

# OpenAI 兼容图像接口（可选）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ===== 演示数据 =====
# 1 = 首次启动写入演示账号与示例剧集
SEED_DEMO=1
DEMO_USERNAME=director
DEMO_PASSWORD=anime2025
